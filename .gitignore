# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
develop-eggs/
sdist/
wheels/

# PyInstaller
*.spec

# Virtual environments
.venv/
venv/
env/
ENV/

# MkDocs build output (published to gh-pages, not committed). Anchor the rule to
# the repository root: a bare ``site/`` also swallowed ``docs/site/``, which is the
# *source* of the 5-language guide (the docs workflow triggers on it).
docs/_site/
/site/

# Unit test / coverage
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE / editor
.idea/
.vscode/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Local secrets (never commit API keys)
/opencode-go.txt
/openrouter.txt

# Speed-test outputs: large translated EPUBs and per-run logs are analysis
# material, not sources. The tool (tools/speedtest.py) and the aggregated
# speedtest/report.md + summary.json are the committed part.
/speedtest/runs/
/speedtest/config-prepare/
/speedtest/matrix.log
